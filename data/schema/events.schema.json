{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "event_type", "date", "date_precision", "rider_ids", "location_id", "description", "source_refs"],
    "properties": {
      "id": {"type": "string"},
      "event_type": {"type": "string"},
      "date": {"type": "string", "format": "date"},
      "date_precision": {"type": "string"},
      "rider_ids": {"type": "array", "items": {"type": "string"}},
      "location_id": {"type": "string"},
      "description": {"type": "string"},
      "source_refs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["source_id", "note"],
          "properties": {
            "source_id": {"type": "string"},
            "note": {"type": "string"}
          }
        }
      }
    }
  }
}
