{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/ofrmp.schema.json",
  "title": "Open Freedom Rides Mapping Project Data Dictionary",
  "type": "object",
  "required": ["riders", "carriers", "facilities", "segments"],
  "properties": {
    "riders": {
      "type": "array",
      "items": { "$ref": "#/$defs/rider" }
    },
    "carriers": {
      "type": "array",
      "items": { "$ref": "#/$defs/carrier" }
    },
    "facilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/facility" }
    },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "rider": {
      "type": "object",
      "required": ["rider_id", "name", "affiliation", "gender", "biographical_data"],
      "properties": {
        "rider_id": {
          "type": "string",
          "pattern": "^R-[0-9]{4}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "affiliation": {
          "type": "string",
          "enum": ["CORE", "SNCC", "SCLC", "NAACP", "INDEPENDENT"]
        },
        "gender": {
          "type": "string",
          "enum": ["MALE", "FEMALE", "NONBINARY"]
        },
        "biographical_data": {
          "type": "object",
          "required": ["hometown", "birth_year", "wikipedia_url"],
          "properties": {
            "hometown": {
              "type": "string",
              "minLength": 1
            },
            "birth_year": {
              "type": "integer"
            },
            "death_year": {
              "type": ["integer", "null"]
            },
            "wikipedia_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "carrier": {
      "type": "object",
      "required": ["carrier_id", "name", "parent_network", "regional_division"],
      "properties": {
        "carrier_id": {
          "type": "string",
          "pattern": "^C-[0-9]{4}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent_network": {
          "type": "string",
          "enum": [
            "GREYHOUND_LINES",
            "NATIONAL_TRAILWAYS_SYSTEM",
            "SOUTHERN_RAILWAY",
            "INDEPENDENT"
          ]
        },
        "regional_division": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "facility": {
      "type": "object",
      "required": ["facility_id", "name", "type", "carrier_id", "coordinates"],
      "properties": {
        "facility_id": {
          "type": "string",
          "pattern": "^FAC-[0-9]{4}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["BUS_DEPOT", "RAIL_STATION", "AIRPORT", "ROADSIDE_LOCATION"]
        },
        "carrier_id": {
          "type": "string",
          "pattern": "^C-[0-9]{4}$"
        },
        "coordinates": {
          "type": "object",
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "segment_id",
        "prior_segment_id",
        "next_segment_id",
        "start_iso_datetime",
        "end_iso_datetime",
        "start_facility_id",
        "end_facility_id",
        "transit_mode",
        "carrier_id",
        "route_geometry",
        "confidence_score",
        "incident",
        "riders_on_board"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^SEG-[0-9]{4}$"
        },
        "prior_segment_id": {
          "type": ["string", "null"],
          "pattern": "^SEG-[0-9]{4}$"
        },
        "next_segment_id": {
          "type": ["string", "null"],
          "pattern": "^SEG-[0-9]{4}$"
        },
        "start_iso_datetime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "end_iso_datetime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "start_facility_id": {
          "type": "string",
          "pattern": "^FAC-[0-9]{4}$"
        },
        "end_facility_id": {
          "type": "string",
          "pattern": "^FAC-[0-9]{4}$"
        },
        "transit_mode": {
          "type": "string",
          "enum": ["BUS", "RAIL", "AIR"]
        },
        "carrier_id": {
          "type": "string",
          "pattern": "^C-[0-9]{4}$"
        },
        "route_geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "confidence_score": {
          "type": "string",
          "enum": ["HIGH_DOCUMENTED", "MEDIUM_CORRIDOR", "LOW_INFERRED"]
        },
        "incident": {
          "type": "object",
          "required": ["occurred", "type", "details"],
          "properties": {
            "occurred": {
              "type": "boolean"
            },
            "type": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["VIOLENCE", "ARREST", "INTIMIDATION", "NONE"]
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "details": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "riders_on_board": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R-[0-9]{4}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
